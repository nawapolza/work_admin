# Backend
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
FRONTEND_ORIGINS=*
# Admin: เปลี่ยนค่าทั้ง 3 รายการก่อนนำระบบขึ้นใช้งานจริง
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_SESSION_HOURS=8
# เปิด true เฉพาะเมื่อเว็บใช้งานผ่าน HTTPS
COOKIE_SECURE=false
# 0 = ไม่จำกัดขนาดไฟล์เป็น MB (ระบบจะย่อภาพขนาดใหญ่มากก่อน inference)
MAX_UPLOAD_MB=0
MAX_IMAGE_PIXELS=80000000
MODEL1_TTA=true
MODEL1_TTA_VARIANTS=4

# Model 1: mango / non_mango
MODEL1_PATH=backend/models/mango_detector.h5
MODEL1_CLASSES=mango,non_mango
MODEL1_INPUT_SIZE=224,224
MODEL1_RESAMPLE=nearest
MODEL1_COLOR_MODE=rgb
MODEL1_PREPROCESS=rescale
MODEL1_OUTPUT_MODE=auto
# สำคัญมากสำหรับ sigmoid output 1 ค่า: ใส่ index ของ class ที่ค่า sigmoid=1
# ถ้า train ด้วย class_indices {'mango': 0, 'non_mango': 1} ให้ใช้ 1
# ถ้า train ด้วย class_indices {'non_mango': 0, 'mango': 1} ให้ใช้ 1 และสลับ MODEL1_CLASSES ให้ตรง
MODEL1_BINARY_POSITIVE_INDEX=1
MODEL1_MANGO_CLASS=mango
MODEL1_THRESHOLD=0.70

# Model 2: stage1-stage5
MODEL2_PATH=backend/models/ripeness_classifier.h5
MODEL2_CLASSES=stage1,stage2,stage3,stage4,stage5
# โมเดลเดิมของคุณมี 6 output: non_mango,stage1,stage2,stage3,stage4,stage5
# Adapter จะตัด index 0 ภายใน Backend แต่หน้าเว็บ/ผล Model 2 ยังมีแค่ stage1-stage5
MODEL2_LEGACY_6_ENABLE=true
MODEL2_LEGACY_6_NON_MANGO_INDEX=0
MODEL2_INPUT_SIZE=224,224
MODEL2_RESAMPLE=nearest
MODEL2_COLOR_MODE=rgb
MODEL2_PREPROCESS=rescale
MODEL2_OUTPUT_MODE=auto
MODEL2_BINARY_POSITIVE_INDEX=1
MODEL2_TTA=false
MODEL2_TTA_VARIANTS=4
# น้ำหนักหลักฐานสี/จุดดำ 0.00-0.45; โมเดล Keras ยังเป็นตัวตัดสินหลัก
MODEL2_VISUAL_WEIGHT=0.0

# Frontend
# เว้นว่างเพื่อใช้ /api ผ่าน Vite/Nginx proxy (รองรับมือถือใน Network เดียวกัน)
VITE_API_BASE_URL=
